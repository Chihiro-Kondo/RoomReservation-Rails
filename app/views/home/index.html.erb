<div class="containar mt-4">
  <%= form_with url: root_path, method: :get, local: true do %>

    <div class="row">
      <div class="col-md-10">
        <%= text_field_tag :keyword, params[:keyword], placeholder: "エリア名を入力", class: "form-control" %>
      </div>
    
    
      <div class="col-md-2">
        <%= submit_tag "検索", class: "btn btn-primary w-100" %>
      </div>
    </div>
  <% end %>
</div>