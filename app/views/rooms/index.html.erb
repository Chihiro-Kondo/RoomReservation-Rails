<div class="search-wrapper">
  <%= form_with url: rooms_path, method: :get, local: true,
  class: "d-flex justify-content-center align-items-center gap-3" do %>

    <div class="col-md-6">
      <%= text_field_tag :address, params[:address], 
      placeholder: "エリアを検索", class: "form-control search-box" %>
    </div>

    <div class="col-md-6">
      <%= text_field_tag :keyword, params[:keyword], 
      placeholder: "フリーワード検索", class: "form-control search-box" %>
    </div>
 
      <%= submit_tag "検索", class: "btn btn-primary search-btn2" %>
    
  <% end %>
</div>

<div class="container mt-5 mx-2">
  <h3 class="search-count">
    <%= @rooms.count %>件見つかりました。
  </h3>
  
  <div class ="row">

    <% @rooms.each do |room| %>
      <div class="col-lg-4 col-md-6 mb-4">

        <div class="Room-card">

          <% if room.image? %>
            <%= image_tag room.image.thumb.url, class: "roomImageThumb" %>
          
          <% end %>

          <div class="room-body">
          
            <h4><%= room.name %></h4>

            <p class="address">
              <%= room.address %>
            </p>

            <p class="description">
              <%= truncate(room.description, length: 80) %>
            </p>

            <div class="room-footer">
              <span class="price">
                ¥<%= number_with_delimiter(room.price) %>~
              </span>

              <%= link_to "詳細はこちら", room_path(room), class: "detail-btn" %>
            </div>
          </div>
        </div>
      </div> 
    <% end %>
  </div> 
</div>
