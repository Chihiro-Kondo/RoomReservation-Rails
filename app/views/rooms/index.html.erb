<div class="search-wrapper">
  <%= form_with url: rooms_path, method: :get, local: true,
  class: "d-flex justify-content-center align-items-center gap-3" do %>

    <div class="col-md-6">
      <%= text_field_tag :address, params[:address], 
      placeholder: "エリアを検索", class: "form-control search-box" %>
    </div>

    <div class="col-md-6">
      <%= text_field_tag :keyword, params[:keyword], 
      placeholder: "フリーワード検索", class: "form-control search-box" %>
    </div>
 
      <%= submit_tag "検索", class: "btn btn-primary search-btn2" %>
    
  <% end %>
</div>

<div class="Room-card">
  <% @rooms.each do |room| %>
    
  <% end %>
</div>
