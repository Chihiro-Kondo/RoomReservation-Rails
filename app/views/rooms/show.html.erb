#施設1件の詳細を表示
<div class="container mt-4">
  <%= link_to "←戻る", request.referer || root_path, class: "back-link" %>
  
  <div class="row mt-4">
    <div class="col-md-5">
      
      <% if @room.image? %>
        <%= image_tag @room.image.url, class: "img-fluid room-image" %>
      <% else %>
          <%= image_tag "default-room.png", class: "detail-room-image" %>
      <% end %>
    </div>

    <div class ="col-md-7 room-detail">
      
      <div class="d-flex justify-content-between align-items-start">
        
        <div>
          <h2><%= @room.name %></h2>

          <p class="text-muted"><%= @room.address %></p>
        </div>

        <h1 class="price">
          ¥<%= number_with_delimiter(@room.price) %>~
        </h1>
      </div>

      <p class="mt-4">
        <%= @room.description %>
      </p>

      <div class="reseervation-box">
        <div class="row">

          <div class="col-md-4">
          #予約モデルを作成後に以下を実装し直すこと！
            <label>チェックイン</label>
            <input type="date" class="form-control">
          </div>
          
          <div class="col-md-4">
          #予約モデルを作成後に以下を実装し直すこと！
            <label>チェックアウト</label>
            <input type="date" class="form-control">
          </div>

          <div class="col-md-4">
          #予約モデルを作成後に以下を実装し直すこと！
            <label>人数</label>
            <input type="number" min="1" class="form-control" placeholder="人">
          </div>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <%= link_to "予約する", confirm_reservations_path(room_id: @room.id), class: "btn btn-danger w-100" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-primary w-100" %>
      <% end %>
      
    </div>
  </div>
</div>

