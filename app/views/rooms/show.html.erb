<div class="container px-0">
  <%= link_to "←戻る", request.referer || root_path, class: "back-link" %>

   <% if @reservation.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @reservation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

  <div class="row mt-3">
    <div class="col-md-5">
      
      <% if @room.image? %>
        <%= image_tag @room.image.url, class: "img-fluid room-image" %>
      <% else %>
        <%= image_tag "default-room.png", class: "img-fluid room-image" %>
      <% end %>
    
    </div>
   
    <div class ="col-md-6 room-detail">
      
      <div class="d-flex justify-content-between align-items-start">
        
        <div>
          <h2><%= @room.name %></h2>

          <p class="text-muted"><%= @room.address %></p>
        </div>

        <h1 class="price">
          ¥<%= number_with_delimiter(@room.price) %>~
        </h1>
      </div>

      <p class="mt-4">
        <%= @room.description %>
      </p>
      
    <%= form_with model: @reservation, url: confirm_reservations_path, method: :post, local: true do |f| %>
      <%= f.hidden_field :room_id %>

      <div class="reservation-box">
        <div class="row">

          <div class="col-md-4">       
            <%= f.label :checkin_at, "チェックイン" %>
            <%= f.date_field :checkin_at, class: "form-control" %>
          </div>
          
          <div class="col-md-4">
            <%= f.label :checkout_at, "チェックアウト" %>
            <%= f.date_field :checkout_at, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= f.label :guest_count, "人数" %>
            <%= f.number_field :guest_count, min: 1, class: "form-control", placeholder: "人" %>
          </div>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <%= f.submit "予約する", class: "btn btn-danger w-100" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-primary w-100" %>
      <% end %>
      
    <% end %>
  </div>
</div>


