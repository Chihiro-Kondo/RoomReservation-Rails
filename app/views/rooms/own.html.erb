<div class="container mt-5">

  <h2 class="mb-5">登録済み一覧</h2>
  
  <!--項目-->
  <div class="row fw-bold border-bottom pb-3 mb-2 room-header">
    <div class="col-2">画像</div>
    <div class="col-2">施設名</div>
    <div class="col-5">紹介文</div>
    <div class="col-1 text-center">料金</div>
    <div class="col-1 text-center">作成日</div>
  </div>
  
  <% @rooms.each do |room| %> 

    <div class="row align-items-center py-4 border-bottom">

      <!-- 画像 -->
      <div class="col-2">
        <% if room.image? %>
          <%= image_tag room.image.url, class: "detail-room-image" %>
        <% else %>
          <%= image_tag "default-room.png", class: "detail-room-image" %>
        <% end %>
      </div>
      
      <!-- 施設名 -->
      <div class="col-2">
        <%=link_to room.name, room_path(room), class: "room-name" %>
      </div>
      
      <!-- 紹介文 -->
      <div class="col-5">
        <%= truncate(room.description, length: 60) %>
      </div>
     
      <!-- 料金 -->
      <div class="col-1 text-center">
        ¥<%= number_with_delimiter(room.price) %>~
      </div>
     
      <!-- 作成日 -->
      <div class="col-1 text-center">
        <%= room.created_at.strftime("%Y/%m/%d") %>
      </div>
      
      <!-- 三点メニュー -->
      <div class="col-1 text-end">
        <div class="dropdown">

          <button class="btn btn-link text-dark p-0" data-bs-toggle="dropdown">

          <i class="bi bi-three-dots-vertical fs-4"></i>
          </button>

          <ul class="dropdown-menu">
            <li>
              <%= link_to "編集", edit_room_path(room), class: "dropdown-item" %>
            </li>

            <li>
              <%= link_to "削除", room_path(room),
              data:{turbo_method: :delete,turbo_confirm: "削除しますか？"}, 
              class: "dropdown-item text-danger" %>
            </li>

          </ul>
        </div>
      </div>
    </div>
  <% end %>
</div>