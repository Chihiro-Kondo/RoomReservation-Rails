<div class="dropdown">

  <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">

    <% if current_user.avatar? %>
      <%= image_tag current_user.avatar.url, class: "avatar" %>
    <% else %>
      <%= image_tag "default-avatar.png", class: "avatar" %>
    <% end %>

    <%= current_user.name %>
  </button>

  <ul class="dropdown-menu dropdown-end">
    <li>
      <%= link_to "施設の新規登録", "/rooms/new", class: "dropdown-item" %>
    </li>
    <li>
      <%= link_to "予約済み一覧", class: "dropdown-item" %>
    </li>
    <li>
      <%= link_to "登録済み一覧", "/rooms/own", class: "dropdown-item" %>
    </li>

    <li><hr class="dropdown-driver"></li>

    <li>
      <%= link_to "アカウント設定", "/users/account", class: "dropdown-item" %>
    </li>
    <li>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
    </li>
  </ul>
</div>
